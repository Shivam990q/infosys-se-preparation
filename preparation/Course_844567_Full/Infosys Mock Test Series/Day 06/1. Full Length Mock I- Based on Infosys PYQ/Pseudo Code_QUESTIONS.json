      "questionText": "Integer a, b, c Set a = 2, b = 4, c = 7 b = 7 + a if (c > b) b = b + b end if b = 6 + a if ((a + b) < (b - a) || c < a) b = (c + 4) + c else a = c + b end if c = (c + 9) ^ a Print a + b + c",
      "questionHtml": "<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">Integer a, b, c<o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">Set a = 2, b = 4, c = 7<o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">b = 7 + a&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">if (c &gt; b)&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">&nbsp;&nbsp; b = b + b&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">end if&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">b = 6 + a&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">if ((a + b) &lt; (b - a) || c &lt; a)&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">&nbsp;&nbsp; b = (c + 4) + c&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">else&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">&nbsp;&nbsp; a = c + b&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">end if&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 14pt; line-height: 115%;\">c = (c + 9) ^ a&nbsp; <o:p></o:p></span></p>\n<p class=\"MsoNormal\" style=\"margin: 0cm 0cm 8pt; line-height: 22px; font-size: 11pt; font-family: Calibri, sans-serif; color: #000000;\"></p>\n<p class=\"MsoNormal\"><span style=\"font-size: 18.0pt; line-height: 115%;\"><span style=\"font-size: 14pt;\">Print a + b + c &nbsp;</span><o:p></o:p></span></p>",
